---
import PublicImage from '../components/PublicImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import PageJumpLinks from '../components/PageJumpLinks.astro';
import BookingButton from '../components/BookingButton.astro';
import FAQSection from '../components/FAQSection.astro';
import ServiceArticles from '../components/ServiceArticles.astro';
const nutrients = [
  {
    "title": "Vitamin B12",
    "description": "One of the most common deficiencies, especially in vegetarians, older adults and those taking metformin or acid blockers.",
    "signs": "Fatigue, numbness/tingling, poor memory, depression, smooth tongue"
  },
  {
    "title": "Iron",
    "description": "Common in menstruating women, vegetarians and those with digestive issues. Often under-diagnosed using standard lab ranges.",
    "signs": "Fatigue, shortness of breath, pale skin, cold hands/feet, brittle nails, restless legs"
  },
  {
    "title": "Vitamin D",
    "description": "Extremely common in Canada due to limited sun exposure. Affects immune function, mood, bone health and more.",
    "signs": "Frequent illness, fatigue, bone pain, muscle weakness, depression, slow wound healing"
  },
  {
    "title": "Magnesium",
    "description": "Depleted by stress, alcohol and many medications. Standard blood tests miss most deficiencies.",
    "signs": "Muscle cramps, insomnia, anxiety, headaches, constipation, heart palpitations"
  },
  {
    "title": "Zinc",
    "description": "Essential for immune function, wound healing and hormone production. Common in vegetarians and those with digestive issues.",
    "signs": "Frequent infections, slow wound healing, hair loss, loss of taste/smell, skin issues"
  },
  {
    "title": "Folate",
    "description": "Critical for methylation, mood and energy. Some people have genetic variants (MTHFR) that impair folate metabolism.",
    "signs": "Fatigue, irritability, sore tongue, digestive issues, elevated homocysteine"
  }
];
---

<BaseLayout
  title="Clinical Nutrition | Halifax Naturopath"
  description="Clinical nutrition in Halifax: lab-guided assessment and targeted nutrient therapy to identify and address nutritional deficiencies using evidence-based protocols."
  focusKeyword="clinical nutrition Halifax"
>
  <HeroSection
    title="Clinical Nutrition"
    compact
  >
    <p>Nutrient deficiencies are far more common than most people realize, and can be the hidden cause of fatigue, poor immune function, mood issues and chronic disease.</p>
    <p class="text-white/80">Dr. MacLeod uses lab testing and clinical assessment to identify deficiencies and develop targeted treatment plans using food, supplements and when needed, injection or IV therapy.</p>
    <div slot="media" class="mx-auto aspect-[16/9] w-full max-w-lg overflow-hidden rounded-2xl lg:max-w-none">
      <PublicImage src="/images/reference/services/clinical-nutrition.webp" alt="Clinical nutrition assessment and healthy foods"   class="h-full w-full object-cover" loading="eager" />
    </div>
  </HeroSection>

  <PageJumpLinks items={[
    { id: 'assessment', title: 'Assessment' },
    { id: 'care', title: 'Care approach' },
    { id: 'nutrients', title: 'Nutrient reference' },
    { id: 'questions', title: 'Questions' },
  ]} />

  <section id="assessment" class="care-section scroll-mt-32">
    <div class="section-shell">
      <div class="mx-auto grid max-w-5xl gap-8 md:grid-cols-[0.8fr_1.2fr] lg:gap-16">
        <div>
          <p class="mb-3 text-sm font-semibold text-emerald-700">Understanding your nutritional needs</p>
          <h2 class="text-3xl font-serif font-medium text-emerald-950 sm:text-4xl">How We Assess Nutritional Status</h2>
        </div>
        <ol class="divide-y divide-emerald-100 border-y border-emerald-100">
          {[
            { title: 'Review your concerns', text: 'Discuss your symptoms, health history, medications and priorities, including changes in energy, digestion, skin, hair or nails.' },
            { title: 'Understand your eating patterns', text: 'Review your food intake, dietary preferences, lifestyle and factors that may affect absorption or individual nutrient needs.' },
            { title: 'Consider relevant testing', text: 'Review previous results and discuss whether further laboratory assessment would help guide your plan. Examples include B12, folate, iron studies and vitamin D.' },
          ].map(({ title, text }, index) => (
            <li class="flex gap-4 py-6 sm:gap-6">
              <span class="pt-1 text-sm font-semibold text-emerald-700" aria-hidden="true">0{index + 1}</span>
              <div><h3 class="mb-2 font-sans text-lg font-semibold text-emerald-950">{title}</h3><p class="max-w-[65ch] leading-relaxed text-slate-600">{text}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section id="care" class="care-section care-section--tint scroll-mt-32">
    <div class="section-shell">
      <div class="mx-auto max-w-5xl">
        <div class="grid gap-6 md:grid-cols-[0.8fr_1.2fr] lg:gap-16">
          <div>
            <p class="mb-3 text-sm font-semibold text-emerald-700">The foundation of your plan</p>
            <h2 class="text-3xl font-serif font-medium text-emerald-950 sm:text-4xl">Food First</h2>
          </div>
          <div class="max-w-[65ch] space-y-4 text-lg leading-relaxed text-slate-700">
            <p>Dietary changes are the foundation of care. Your plan focuses on nutrient-dense foods, your current eating patterns and your individual needs.</p>
            <p>Food choices, preferences and digestive concerns are considered together, with recommendations tailored to your circumstances.</p>
          </div>
        </div>
        <div class="mt-10 border-t border-emerald-200 pt-7">
          <h3 class="mb-5 text-xl font-serif font-medium text-emerald-950">Other options considered during assessment</h3>
          <dl class="divide-y divide-emerald-100">
            <div class="grid gap-2 py-5 sm:grid-cols-[12rem_1fr] sm:gap-8">
              <dt class="font-semibold text-emerald-950">Oral supplements</dt>
              <dd class="max-w-[65ch] leading-relaxed text-slate-600">Capsules, tablets, powders or liquids selected according to your nutritional needs and digestive capacity.</dd>
            </div>
            <div class="grid gap-2 py-5 sm:grid-cols-[12rem_1fr] sm:gap-8">
              <dt class="font-semibold text-emerald-950">Injections &amp; IV therapy</dt>
              <dd class="max-w-[65ch] leading-relaxed text-slate-600">These options require individual assessment. All new patients complete an initial consultation first; any recommended injection or IV treatment is scheduled separately afterward. <a href="/iv-therapy/" class="font-medium text-emerald-800 underline underline-offset-4">About IV therapy</a></dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section id="nutrients" class="care-section scroll-mt-32">
    <div class="section-shell">
      <div class="mx-auto grid max-w-5xl gap-8 md:grid-cols-[0.8fr_1.2fr] lg:gap-16">
        <div>
          <h2 class="mb-4 text-3xl font-serif font-medium text-emerald-950 sm:text-4xl">Common Nutrient Deficiencies</h2>
          <p class="leading-relaxed text-slate-600">Explore the nutrient information below, or <a href="/nutrient-testing/" class="font-medium text-emerald-800 underline underline-offset-4">learn about nutrient testing</a>.</p>
        </div>
        <div class="divide-y divide-emerald-100 border-y border-emerald-100">
          {nutrients.map(nutrient => (
            <details class="group">
              <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-4 rounded-sm py-4 text-lg font-semibold text-emerald-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 [&::-webkit-details-marker]:hidden">
                {nutrient.title}
                <span class="text-xl font-normal text-emerald-700" aria-hidden="true"><span class="group-open:hidden">+</span><span class="hidden group-open:inline">−</span></span>
              </summary>
              <div class="space-y-3 pb-6 leading-relaxed text-slate-600">
                <p>{nutrient.description}</p>
                <p><strong class="font-semibold text-slate-700">Common signs:</strong> {nutrient.signs}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="your-health-in-context" class="care-section border-t">
    <div class="section-shell">
      <div class="mx-auto grid max-w-5xl gap-8 md:grid-cols-[0.8fr_1.2fr] lg:gap-16">
        <h2 class="text-3xl font-serif font-medium text-emerald-950">Your Health in Context</h2>
        <div class="max-w-[65ch] space-y-4 leading-relaxed text-slate-600">
          <p>Your assessment brings together your concerns, eating patterns, previous results and current care. Dietary preferences, digestive disorders, medications and changes in needs over time all inform the discussion.</p>
          <p>Bring a current list of medications and supplements, along with any results you would like reviewed.</p>
        </div>
      </div>
    </div>
  </section>

  <FAQSection id="questions" bg="white" sectionClass="bg-white pt-8 lg:pt-12 pb-12 lg:pb-16" items={[
          { question: "Why do I need testing if I eat a healthy diet?", answer: "<p>Even with a healthy diet, deficiencies can occur due to soil depletion, digestive issues that impair absorption, medications that deplete nutrients, genetic variations affecting metabolism or increased needs due to stress or health conditions. Testing removes the guesswork.</p>" },
          { question: "How is this different from taking a multivitamin?", answer: "<p>Multivitamins provide small, generic doses of many nutrients. Clinical nutrition identifies your specific deficiencies and provides therapeutic doses of exactly what you need. This targeted approach is more effective and avoids unnecessary supplementation.</p>" },
          { question: "When would IV therapy be recommended over oral supplements?", answer: "<p>IV therapy is typically recommended when digestive absorption is compromised, deficiencies are severe and need rapid correction or when therapeutic doses higher than oral absorption allows are beneficial (such as high-dose vitamin C for immune support).</p>" },
          { question: "Is nutritional testing covered by insurance?", answer: "<p>Naturopathic consultations are covered by many extended health plans. Lab testing is typically an out-of-pocket expense but qualifies as a medical expense for tax purposes. We'll discuss costs upfront so you can make informed decisions.</p>" },
        ]} />

  <ServiceArticles
    slugs={["fiber-the-underrated-nutrient", "digestive-health-natural-approaches", "natural-weight-loss-solutions"]}
    subtitle="Explore our articles on nutrition and health optimization."
  />

  <!-- CTA Section -->
  <section class="care-closing">
    <div class="section-shell text-center">
      <h2 class="text-3xl sm:text-4xl font-serif font-medium text-white mb-6">Uncover Hidden Deficiencies</h2>
      <p class="text-lg sm:text-xl text-white/90 mb-8 max-w-3xl mx-auto leading-relaxed">
        Book a consultation to assess your nutritional status and develop a targeted plan to optimize your nutrient levels and improve your health.
      </p>
      <div class="flex justify-center">
        <BookingButton source="clinical-nutrition-cta" placement="closing" />
      </div>
    </div>
  </section>

  <!-- Service Schema Structured Data -->
  <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Clinical Nutrition",
      "serviceType": "Nutritional Therapy",
      "description": "Clinical nutrition assessment and targeted nutrient therapy using lab testing, symptom analysis and evidence-based protocols to identify and correct nutritional deficiencies.",
      "provider": {
        "@type": "Person",
        "name": "Dr. Colin MacLeod",
        "jobTitle": "Naturopathic Doctor"
      },
      "areaServed": {
        "@type": "City",
        "name": "Halifax",
        "containedInPlace": {
          "@type": "State",
          "name": "Nova Scotia"
        }
      },
      "availableChannel": {
        "@type": "ServiceChannel",
        "serviceUrl": "https://drcolinmacleod.com/clinical-nutrition/",
        "serviceLocation": {
          "@type": "Place",
          "name": "Optimal Wellbeing Clinic",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "1378 Bedford Highway, Unit 1",
            "addressLocality": "Bedford",
            "addressRegion": "Nova Scotia",
            "postalCode": "B4A 1E2",
            "addressCountry": "CA"
          }
        }
      }
    }
  </script>
</BaseLayout>
