---
import PublicImage from '../components/PublicImage.astro';
import FeaturedServices from '../components/FeaturedServices.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingButton from '../components/BookingButton.astro';
import FAQSection from '../components/FAQSection.astro';
import { Phone, MessageCircle, ChevronRight, ShieldCheck, Clock, CreditCard, MapPin } from '@lucide/astro';

// FAQ data for schema markup
const faqItems = [
  {
    question: "Can naturopathic doctors order blood tests?",
    answer: "Yes. As a naturopathic doctor, Dr. MacLeod can order a comprehensive range of blood and laboratory tests through private labs. This includes thyroid panels, hormone levels, nutrient status, inflammatory markers and more. Private testing often means broader panels and faster turnaround compared to the public system, giving us a clear picture of your health."
  },
  {
    question: "Is naturopathic care covered by insurance?",
    answer: "Yes, most extended health insurance plans cover naturopathic visits. We offer direct billing for many major insurers to make the process convenient for you."
  },
  {
    question: "Do you work alongside my family doctor?",
    answer: "Absolutely. Naturopathic care is most effective as part of a coordinated care approach. I regularly share findings and treatment summaries with family doctors and specialists when patients consent. While naturopathic doctors don't have direct referral privileges in Nova Scotia, I actively communicate with other healthcare providers to help facilitate appropriate referrals where needed."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<BaseLayout
  title="Home"
  description="Dr. Colin MacLeod, ND in Halifax, NS. Evidence-based naturopathic care, IV therapy, prolotherapy, acupuncture, nutrition."
  focusKeyword="Dr. Colin MacLeod, ND, Halifax naturopathic doctor, IV therapy, prolotherapy, acupuncture"
  image="/images/og-image.jpg"
>
  <!-- Homepage hero -->
  <section class="hero-gradient -mt-24 pt-24 relative overflow-hidden">
    <!-- Ambient background shapes -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
      <div class="absolute -top-32 -right-32 w-96 h-96 bg-emerald-800/20 rounded-full blur-3xl"></div>
      <div class="absolute top-1/2 -left-24 w-64 h-64 bg-emerald-700/15 rounded-full blur-2xl"></div>
      <div class="absolute bottom-0 right-1/4 w-80 h-80 bg-emerald-600/10 rounded-full blur-3xl"></div>
    </div>

    <div class="section-shell relative z-10 py-6 sm:py-14 lg:py-20">
      <div class="grid items-center gap-8 lg:grid-cols-[1.08fr_0.92fr] lg:gap-16">
        <div class="space-y-4 sm:space-y-6 lg:space-y-7">
          <!-- Compact mobile portrait -->
          <div class="flex justify-center max-[359px]:hidden lg:hidden">
            <a href="/about/" aria-label="About Dr. Colin MacLeod, ND" class="block h-24 w-24 sm:h-28 sm:w-28 overflow-hidden rounded-2xl border-2 border-white/20 shadow-xl shadow-black/25 transition-all duration-300 hover:border-white/40">
              <picture>
                <source srcset="/images/general/colin-hero.avif" type="image/avif" />
                <source srcset="/images/general/colin-hero.webp" type="image/webp" />
                <PublicImage
                  src="/images/general/Dr-colin-macleod-ND.jpeg"
                  alt="Dr. Colin MacLeod, ND"
                  class="h-full w-full object-cover object-top max-lg:scale-[1.65] max-lg:origin-[85%_20%]"
                  loading="eager"
                />
              </picture>
            </a>
          </div>

          <div class="space-y-4 text-center lg:text-left">
            <p class="text-xs font-medium uppercase tracking-[0.2em] text-emerald-300 sm:text-sm">
              Halifax Naturopathic Doctor
            </p>

            <h1 class="text-[2.1rem] min-[360px]:text-[2.3rem] font-medium font-serif leading-[1.06] tracking-tight text-white sm:text-5xl lg:text-6xl">
              Look beyond symptoms. Build a plan for better health.
            </h1>

            <p class="mx-auto max-w-xl text-base leading-relaxed text-emerald-100 sm:text-lg lg:mx-0">
              Naturopathic care in Bedford, serving Halifax. A plan built around your health history, concerns and goals.
            </p>
          </div>

          <div class="flex flex-col items-center justify-center gap-3 sm:flex-row lg:justify-start">
            <BookingButton destination="initial" text="Book Online" variant="primary" surface="dark" size="lg" source="hero" placement="hero" />
            <a
              href="/new-patients/"
              class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-white/55 bg-white/10 px-6 py-3 font-medium text-white backdrop-blur-sm transition-all hover:-translate-y-0.5 hover:border-white/75 hover:bg-white/20"
            >
              Your First Visit
              <ChevronRight class="h-4 w-4 text-emerald-300" aria-hidden="true" />
            </a>
          </div>

          <p class="text-center text-sm text-emerald-100 lg:text-left">New patients: 60-minute consultation · $200</p>

          <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm text-emerald-200 lg:justify-start">
            <a href="tel:+19024064424" class="inline-flex min-h-11 items-center gap-2 px-1 transition-colors hover:text-white">
              <Phone class="h-4 w-4" aria-hidden="true" />
              Call the clinic
            </a>
            <a href="sms:+19027070230" data-text-source="homepage-hero" class="inline-flex min-h-11 items-center gap-2 px-1 transition-colors hover:text-white">
              <MessageCircle class="h-4 w-4" aria-hidden="true" />
              Text the clinic
            </a>
          </div>
        </div>

        <!-- Desktop portrait -->
        <div class="relative hidden justify-center lg:flex">
          <div class="relative group">
            <a href="/about/" aria-label="About Dr. Colin MacLeod, ND" class="block h-[27rem] w-[21rem] overflow-hidden rounded-[2rem] border-2 border-white/20 shadow-2xl shadow-black/30 transition-all duration-300 hover:scale-[1.01] hover:border-white/40 hover:shadow-black/45 xl:h-[30rem] xl:w-[23rem]">
                <picture>
                  <source srcset="/images/general/colin-hero.avif" type="image/avif" />
                  <source srcset="/images/general/colin-hero.webp" type="image/webp" />
                  <PublicImage
                    src="/images/general/Dr-colin-macleod-ND.jpeg"
                    alt="Dr. Colin MacLeod, ND"
                    class="h-full w-full object-cover object-top"
                    loading="eager"
                  />
                </picture>
            </a>
            <span class="pointer-events-none absolute -bottom-9 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-emerald-950/90 px-4 py-1.5 text-sm font-medium text-white opacity-0 transition-opacity duration-200 group-hover:opacity-100">About Dr. MacLeod</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Compact trust signals -->
  <section class="border-b border-emerald-100 bg-emerald-50/70">
    <div class="section-shell py-6">
      <div class="grid grid-cols-2 gap-x-5 gap-y-5 text-sm text-slate-700 lg:grid-cols-4 lg:gap-8">
        <div class="flex items-center gap-3">
          <ShieldCheck class="h-5 w-5 flex-none text-emerald-700" aria-hidden="true" />
          <span>Licensed ND in Nova Scotia</span>
        </div>
        <div class="flex items-center gap-3">
          <Clock class="h-5 w-5 flex-none text-emerald-700" aria-hidden="true" />
          <span>More than 15 years in practice</span>
        </div>
        <div class="flex items-center gap-3">
          <CreditCard class="h-5 w-5 flex-none text-emerald-700" aria-hidden="true" />
          <span>Direct billing available</span>
        </div>
        <div class="flex items-center gap-3">
          <MapPin class="h-5 w-5 flex-none text-emerald-700" aria-hidden="true" />
          <span>Bedford clinic serving Halifax</span>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-emerald-100 bg-white py-10 sm:py-14" aria-labelledby="your-concerns">
    <div class="section-shell">
      <div class="mb-6 max-w-2xl">
        <h2 id="your-concerns" class="mb-3 text-2xl sm:text-3xl font-serif font-medium text-emerald-950">What brings you here?</h2>
        <p class="leading-relaxed text-slate-600">You do not need to know which treatment to choose. Start with your concern, or find out what a first visit involves.</p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {[
          { title: 'Questions about blood work', detail: 'Explore private testing and reviewing results.', href: '/lab-testing/' },
          { title: 'Back, joint or muscle pain', detail: 'Find information about pain and injury care.', href: '/conditions/' },
          { title: 'Nutrition and digestive concerns', detail: 'Learn about an individualized nutrition assessment.', href: '/clinical-nutrition/' },
          { title: 'Persistent symptoms or unsure?', detail: 'Start with a conversation about your concerns.', href: '/new-patients/' },
        ].map(({ title, detail, href }) => (
          <a href={href} class="group rounded-2xl border border-emerald-200 bg-emerald-50/40 p-5 transition-colors hover:bg-emerald-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 focus-visible:ring-offset-2">
            <h3 class="mb-2 flex items-start justify-between gap-3 font-sans text-base font-semibold text-emerald-950">{title}<ChevronRight class="mt-0.5 h-5 w-5 shrink-0 text-emerald-700" aria-hidden="true" /></h3>
            <p class="text-sm leading-relaxed text-slate-600">{detail}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-12 lg:py-16 bg-white">
    <div class="section-shell">
      <div class="text-center max-w-3xl mx-auto mb-8 space-y-3 ">
        <h2 class="text-3xl sm:text-4xl font-serif font-medium text-emerald-950 tracking-tight">Services</h2>
        <p class="text-lg text-slate-600 max-w-2xl mx-auto">Private testing and treatments tailored to your concerns, health history and goals.</p>
      </div>

      <div class="">
        <FeaturedServices />
      </div>

      <div class="text-center mt-8">
        <a
          href="/services/"
          class="inline-flex items-center bg-emerald-900 text-white px-10 py-4 rounded-full text-base font-medium tracking-wide hover:bg-emerald-800 hover:-translate-y-0.5 transition-all duration-200 shadow-lg shadow-emerald-900/20 hover:shadow-xl hover:shadow-emerald-900/25"
        >
          View All Services
        </a>
      </div>
    </div>
  </section>

  <FAQSection
    bg="white"
    sectionClass="pt-0 pb-16 lg:pt-0 lg:pb-24 bg-white"
    title="Common Questions"
    subtitle="Answers to what patients most commonly ask before their first visit."
    headingClass="text-3xl sm:text-4xl font-serif font-medium text-emerald-950"
    includeSchema={false}
    items={[
      {
        question: 'Can naturopathic doctors order blood tests?',
        answer: '<p>Yes. As a naturopathic doctor, Dr. MacLeod can order a comprehensive range of blood and laboratory tests through private labs. This includes thyroid panels, hormone levels, nutrient status, inflammatory markers and more. Private testing often means broader panels and faster turnaround compared to the public system, giving us a clear picture of your health.</p>',
      },
      {
        question: 'Is naturopathic care covered by insurance?',
        answer: '<p>Yes, most extended health insurance plans cover naturopathic visits. We offer direct billing for many major insurers to make the process convenient for you.</p>',
      },
      {
        question: 'Do you work alongside my family doctor?',
        answer: "<p>Absolutely. Naturopathic care is most effective as part of a coordinated care approach. I regularly share findings and treatment summaries with family doctors and specialists when patients consent. While naturopathic doctors don't have direct referral privileges in Nova Scotia, I actively communicate with other healthcare providers to help facilitate appropriate referrals where needed.</p>",
      },
    ]}
  />

  <!-- Closing CTA -->
  <section class="py-14 lg:py-16 bg-emerald-950">
    <div class="section-shell text-center space-y-6 ">
      <h2 class="text-3xl sm:text-4xl font-serif font-medium text-white">Ready to discuss your health and testing needs?</h2>
      <p class="text-emerald-200 text-lg max-w-2xl mx-auto">All new patients begin with a one-hour initial consultation ($200) to review concerns and plan next steps. Any recommended IV therapy or injection treatment is scheduled separately afterward.</p>
      <div>
        <BookingButton text="Book Online" variant="primary" surface="dark" size="lg" destination="initial" source="bottom-cta" placement="closing" />
      </div>
      <div class="flex flex-wrap justify-center gap-x-4 gap-y-2 text-sm text-emerald-200">
        <span>No referral needed</span>
        <span aria-hidden="true">·</span>
        <span>Direct billing available</span>
      </div>
    </div>
  </section>

  <!-- FAQ Schema for AI discoverability -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</BaseLayout>
