---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppointmentSummary from '../components/AppointmentSummary.astro';
import HeroSection from '../components/HeroSection.astro';
import PageJumpLinks from '../components/PageJumpLinks.astro';
import FirstVisitGuidance from '../components/FirstVisitGuidance.astro';
import BookingButton from '../components/BookingButton.astro';
import FAQSection from '../components/FAQSection.astro';
import { ChevronRight } from '@lucide/astro';

// Cards are deliberately typographic rather than photographic. The six category
// images still serve as heroes on their own pages, but side by side in one grid
// they mixed four unrelated visual idioms (anatomical illustration, flat vector,
// clinical stock, in-clinic documentary). The hero photo carries the page's
// photographic voice; the grid carries information instead.
const testingOptions = [
  {
    title: 'Thyroid Testing',
    description: 'Individualized thyroid assessment ordered according to symptoms and history.',
    markers: ['TSH', 'Free T4', 'Free T3', 'TPO antibodies'],
    href: '/thyroid-testing/',
  },
  {
    title: 'Hormone Testing',
    description: 'Blood testing for the reproductive and adrenal hormones relevant to your concern.',
    markers: ['Estradiol', 'Progesterone', 'Testosterone', 'FSH & LH'],
    href: '/hormone-testing/',
  },
  {
    title: 'Nutrient Status',
    description: 'Assessment of the nutrients most likely to be contributing to your symptoms.',
    markers: ['Vitamin D', 'B12', 'Ferritin', 'Magnesium'],
    href: '/nutrient-testing/',
  },
  {
    title: 'Wellness Baseline',
    description: 'Broad screening across blood counts, metabolic markers, lipids and blood sugar.',
    markers: ['CBC', 'Lipids', 'HbA1c', 'Creatinine'],
    href: '/wellness-blood-work/',
  },
  {
    title: 'Digestive Health',
    description: 'Tests chosen by what they can actually answer for your symptom pattern.',
    markers: ['Celiac serology', 'Calprotectin', 'Stool analysis', 'Breath testing'],
    href: '/digestive-health-testing/',
  },
  {
    title: 'Specialized Testing',
    description: 'Selected assessments for complex cases where routine testing has not explained things.',
    markers: ['Heavy metals', 'Organic acids', 'Methylation', 'Environmental toxins'],
    href: '/specialized-testing/',
  },
];

const steps = [
  ['1', 'Initial Consultation', 'Discuss your health concerns, previous results and testing priorities with Dr. MacLeod.'],
  ['2', 'Build Your Testing Plan', 'Review the recommended tests, any additional markers you would like considered and the expected costs.'],
  ['3', 'Sample Collection', 'Complete blood collection in the clinic with preparation instructions provided in advance.'],
  ['4', 'Review Results', 'Review the complete pattern and determine practical recommendations or next steps.'],
];

const faqs = [
  { question: "Do I need a doctor's referral for blood work?", answer: "<p>No. You can access comprehensive blood work without a family doctor's requisition. This can be helpful if you do not have a family doctor or want to discuss testing that is not routinely ordered.</p>" },
  { question: 'Is private blood work covered by MSI?', answer: '<p>Testing ordered through a naturopathic doctor is not covered by MSI. Many extended health insurance plans cover naturopathic consultations, while laboratory costs are generally paid out of pocket. Check your individual plan for details.</p>' },
  { question: 'Where is the blood draw performed?', answer: "<p>Dr. MacLeod performs blood collection in the clinic, so you generally will not need to visit a separate laboratory.</p>" },
  { question: 'How long until I get my results?', answer: '<p>Many standard blood tests return within 5–10 business days. Specialized tests such as comprehensive stool analysis or hormone panels may take 2–3 weeks. A follow-up is arranged once the relevant results are available.</p>' },
  { question: 'Do I need to fast before blood tests?', answer: '<p>Some tests require fasting and others do not. You will receive preparation instructions for the tests being ordered.</p>' },
];
---

<BaseLayout
  title="Private Blood Testing and Lab Testing in Halifax"
  description="Private blood work and lab testing in Halifax. Hormone panels, thyroid, nutrient assessments and more. No family doctor requisition required."
  focusKeyword="private blood work Halifax"
>
  <HeroSection
    title="Laboratory Testing"
    compact
    image={{
      src: '/images/lab-testing/in-office-blood-draw.webp',
      alt: 'Dr. Colin MacLeod performing an in-office blood draw',
      aspect: 'square', hideOnMobile: true }}
  >
    <p>Private blood testing and in-office collection in Bedford, without a family doctor's requisition. Choose a testing plan with Dr. MacLeod and review what your results mean.</p>
    <AppointmentSummary slot="cta" source="lab-testing-summary" testing />
  </HeroSection>

  <PageJumpLinks items={[
    { id: 'process', title: 'How it works' },
    { id: 'testing-options', title: 'Testing options' },
    { id: 'questions', title: 'Results timing & questions' },
  ]} />

  <section id="process" class="care-section scroll-mt-32">
    <div class="section-shell">
      <h2 class="mb-10 text-center text-3xl font-serif font-medium text-emerald-950 sm:text-4xl">How It Works</h2>
      <ol class="grid grid-cols-2 gap-5 sm:gap-8 lg:grid-cols-4">
        {steps.map(([number, title, description]) => (
          <li class="text-center">
            <span class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-full bg-emerald-50 text-xl font-semibold text-slate-600 sm:mb-4 sm:h-16 sm:w-16 sm:text-2xl">{number}</span>
            <h3 class="mb-2 text-base font-serif font-medium text-emerald-950 sm:text-lg">{title}</h3>
            <p class="text-sm leading-relaxed text-slate-600">{description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="testing-options" class="care-section scroll-mt-32">
    <div class="section-shell">
      <div class="mb-10 text-left sm:mb-8">
        <h2 class="mb-4 text-3xl font-serif font-medium text-emerald-950 sm:text-4xl">Available Testing</h2>
        <p class="mx-auto max-w-3xl text-lg text-slate-600">Testing is individualized; these are common categories available through the practice. The markers listed are examples rather than a fixed panel.</p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 sm:gap-7 lg:grid-cols-3">
        {testingOptions.map((option) => (
          <a href={option.href} class="directory-link  group flex flex-col  focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2">
            <h3 class="mb-2 text-xl font-serif font-medium text-emerald-950 transition-colors group-hover:text-emerald-700">{option.title}</h3>
            <p class="mb-5 leading-relaxed text-slate-600">{option.description}</p>

            <p class="sr-only">Commonly includes:</p>
            <ul class="mb-6 flex flex-wrap gap-1.5">
              {option.markers.map((marker) => (
                <li class="care-item text-xs font-medium text-emerald-900">{marker}</li>
              ))}
            </ul>

            <span class="mt-auto inline-flex items-center text-sm font-semibold text-emerald-700">
              Learn more <ChevronRight class="ml-1 h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="understanding-your-results" class="care-section care-section--tint">
    <div class="section-shell">
      <div class="grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14">
        <div>
          <h2 class="mb-6 text-3xl font-serif font-medium text-emerald-950 sm:text-4xl">Understanding Your Results</h2>
          <div class="space-y-5 text-lg leading-relaxed text-slate-600">
            <p>Laboratory reference ranges help identify results outside the expected population range, but a number should not be interpreted in isolation.</p>
            <p>Dr. MacLeod reviews symptoms, medications, health history, trends over time and relationships between markers to understand what the complete pattern may mean for an individual patient.</p>
          </div>
        </div>
        <div class="care-item">
          <h3 class="mb-3 text-xl font-serif font-medium text-emerald-950">A testing plan built with you</h3>
          <p class="leading-relaxed text-slate-600">Dr. MacLeod recommends a thorough set of tests based on your health history and goals. If there are additional markers you want investigated, you can review their purpose, cost and limitations together before the requisition is completed.</p>
        </div>
      </div>
    </div>
  </section>

  <FAQSection id="questions" bg="white" items={faqs} />

  <section class="care-closing">
    <div class="section-shell text-center">
      <div class="mx-auto max-w-3xl">
        <h2 class="mb-5 text-3xl font-serif font-medium text-white sm:text-4xl">Plan Your Laboratory Testing</h2>
        <p class="mb-8 text-lg leading-relaxed text-white/85">Book an initial consultation to discuss your concerns, previous results and the routine or specialized testing you would like to access.</p>
        <FirstVisitGuidance pricingHref="/new-patients/#fees" pricingLabel="View consultation fees and insurance information" />
        <BookingButton destination="initial" source="lab-testing-cta" placement="closing" />
      </div>
    </div>
  </section>
</BaseLayout>
