---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import CTAButton from '../components/CTAButton.astro';
import BookingButton from '../components/BookingButton.astro';
import { Check, Droplets, Zap, Atom, HeartPulse, Dna } from '@lucide/astro';
import FAQSection from '../components/FAQSection.astro';
import ServiceArticles from '../components/ServiceArticles.astro';
---

<BaseLayout
  title="IV Therapy"
  description="IV therapy in Bedford, NS, with individualized assessment, clinical screening and monitoring by Dr. Colin MacLeod, ND."
  focusKeyword="IV therapy Halifax"
>
  <HeroSection
    title="IV Therapy"
    compact
    video={{ src: "https://www.youtube.com/embed/sjG8VsLP3u8", title: "IV Therapy Overview" }}
  >
    <p>IV therapy delivers fluids and selected nutrients directly into the bloodstream. Whether it is appropriate depends on your health history, clinical assessment, goals and potential risks.</p>
    <p class="text-white/80">Dr. MacLeod develops individualized protocols with screening and monitoring. Response varies, and IV therapy does not replace appropriate conventional care.</p>
  </HeroSection>

  <!-- Myers Cocktail & Getting Started -->
  <section class="py-16 lg:py-24 bg-emerald-50">
    <div class="section-shell">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Image -->
        <div class="rounded-3xl overflow-hidden shadow-xl">
          <img
            src="/images/treatments/iv-patient-woman.webp"
            alt="Patient receiving IV vitamin therapy in Halifax"
            class="w-full h-full object-cover"
            width="800"
            height="600"
            loading="lazy"
          />
        </div>

        <!-- Content -->
        <div class="bg-white rounded-3xl shadow-xl p-8 lg:p-10 card-hover">
          <h2 class="text-2xl font-serif font-medium text-emerald-950 mb-2">The Myers Cocktail</h2>
          <p class="text-slate-600 mb-4">A commonly used IV nutrient formulation containing vitamins and minerals. Its suitability and composition are assessed individually.</p>

          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-1.5 bg-emerald-100 text-emerald-800 rounded-full text-sm font-medium">Calcium</span>
            <span class="px-3 py-1.5 bg-emerald-100 text-emerald-800 rounded-full text-sm font-medium">Magnesium</span>
            <span class="px-3 py-1.5 bg-emerald-100 text-emerald-800 rounded-full text-sm font-medium">B Vitamins</span>
            <span class="px-3 py-1.5 bg-emerald-100 text-emerald-800 rounded-full text-sm font-medium">B12</span>
            <span class="px-3 py-1.5 bg-emerald-100 text-emerald-800 rounded-full text-sm font-medium">Vitamin C</span>
          </div>

          <div class="border-t border-slate-200 pt-6">
            <h3 class="font-serif font-medium text-lg text-emerald-950 mb-3">Getting Started</h3>
            <p class="text-slate-600 mb-6">
              A consultation is required before beginning IV therapy. We will evaluate your health, discuss your goals and determine if IV therapy is appropriate for you.
            </p>

            <BookingButton variant="secondary" size="lg" fullWidth source="iv-therapy-pricing" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- IV Therapy Boosters -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-shell">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-serif font-medium text-emerald-950 mb-4">Nutrients and Formulations</h2>
        <p class="text-lg text-slate-600 max-w-3xl mx-auto">
          Different nutrients and formulations may be discussed after reviewing clinical need, available evidence, contraindications and potential interactions.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        <!-- NAD+ - Lightning/Energy icon -->
        <a href="/nad-therapy/" class="site-card-interactive group block p-6 text-center">
          <div class="w-20 h-20 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-emerald-200 transition-colors">
            <Zap class="w-10 h-10 text-emerald-700" aria-hidden="true" />
          </div>
          <h3 class="font-serif font-medium text-lg text-emerald-950 mb-2 group-hover:text-emerald-700 transition-colors">NAD+</h3>
          <p class="text-slate-600 text-sm">A coenzyme involved in cellular energy metabolism. Evidence for IV use varies by indication.</p>
        </a>

        <!-- High-Dose Vitamin C -->
        <a href="/iv-vitamin-c/" class="site-card-interactive group block p-6 text-center">
          <div class="w-20 h-20 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-emerald-200 transition-colors">
            <Droplets class="w-10 h-10 text-emerald-700" aria-hidden="true" />
          </div>
          <h3 class="font-serif font-medium text-lg text-emerald-950 mb-2 group-hover:text-emerald-700 transition-colors">High-Dose Vitamin C</h3>
          <p class="text-slate-600 text-sm">An antioxidant nutrient whose IV use requires individual screening and indication-specific consideration.</p>
        </a>

        <!-- Glutathione - Heart with EKG line -->
        <a href="/glutathione/" class="site-card-interactive group block p-6 text-center">
          <div class="w-20 h-20 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-emerald-200 transition-colors">
            <HeartPulse class="w-10 h-10 text-emerald-700" aria-hidden="true" />
          </div>
          <h3 class="font-serif font-medium text-lg text-emerald-950 mb-2 group-hover:text-emerald-700 transition-colors">Glutathione</h3>
          <p class="text-slate-600 text-sm">An antioxidant compound. The evidence and relevance of IV use depend on the clinical context.</p>
        </a>

        <!-- L-Carnitine -->
        <a href="/l-carnitine/" class="site-card-interactive group block p-6 text-center">
          <div class="w-20 h-20 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-emerald-200 transition-colors">
            <Dna class="w-10 h-10 text-emerald-700" aria-hidden="true" />
          </div>
          <h3 class="font-serif font-medium text-lg text-emerald-950 mb-2 group-hover:text-emerald-700 transition-colors">L-Carnitine</h3>
          <p class="text-slate-600 text-sm">A nutrient involved in fatty-acid transport and energy metabolism.</p>
        </a>

        <!-- Trace Minerals -->
        <a href="/trace-minerals/" class="site-card-interactive group block p-6 text-center">
          <div class="w-20 h-20 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:bg-emerald-200 transition-colors">
            <Atom class="w-10 h-10 text-emerald-700" aria-hidden="true" />
          </div>
          <h3 class="font-serif font-medium text-lg text-emerald-950 mb-2 group-hover:text-emerald-700 transition-colors">Trace Minerals</h3>
          <p class="text-slate-600 text-sm">Minerals involved in normal enzyme and metabolic functions.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Nutrients Used & Clinical Considerations -->
  <section class="py-16 lg:py-24 bg-emerald-50">
    <div class="section-shell">
      <div class="grid lg:grid-cols-2 gap-12">
        <!-- Nutrients Used -->
        <div>
          <h2 class="text-2xl font-serif font-medium text-emerald-950 mb-6">Nutrients Used in IV Therapy</h2>
          <div class="grid grid-cols-2 gap-3">
            {['Amino Acid Complex', 'Glutathione', 'Glycine', 'Magnesium', 'Methylfolate', 'NAD', 'Selenium', 'Trace Minerals', 'Taurine', 'Vitamin B1', 'Vitamin B2', 'Vitamin B3', 'Vitamin B5', 'Vitamin B6', 'Vitamin B12', 'Vitamin C', 'Zinc'].map(nutrient => (
              <div class="flex items-center">
                <Check class="w-4 h-4 text-emerald-600 mr-2 flex-shrink-0" aria-hidden="true" />
                <span class="text-slate-700 text-sm">{nutrient}</span>
              </div>
            ))}
            <div class="flex items-center col-span-2 pt-1">
              <Check class="w-4 h-4 text-emerald-600 mr-2 flex-shrink-0" aria-hidden="true" />
              <span class="text-slate-700 text-sm"><a href="/chelation-therapy/" class="text-emerald-700 hover:text-emerald-800 underline">Chelation (EDTA, DMPS)</a></span>
            </div>
          </div>
        </div>

        <!-- Clinical considerations -->
        <div>
          <h2 class="text-2xl font-serif font-medium text-emerald-950 mb-6">Clinical Assessment Comes First</h2>
          <div class="prose prose-lg text-slate-600">
            <p>
              IV therapy is not a general treatment for every symptom or diagnosis. A consultation is used to review medical history, medications, previous testing, hydration status and relevant risks.
            </p>
            <p>
              Where a nutrient deficiency or other clinical indication is identified, oral treatment, dietary changes, referral or conventional medical care may be more appropriate. The expected benefits, uncertainties, alternatives and costs of IV therapy are discussed before consent.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why IV Therapy Section -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="section-shell">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl sm:text-4xl font-serif font-medium text-emerald-950 mb-6">How IV Delivery Differs</h2>
          <div class="prose prose-lg text-slate-600">
            <p>
              IV administration delivers a substance directly into the bloodstream and avoids gastrointestinal absorption. That difference in delivery does not, by itself, establish that an IV will improve a particular symptom or condition.
            </p>
            <p>
              The decision to use an IV depends on whether there is a reasonable clinical indication, whether the proposed formulation is supported for that purpose and whether the potential benefit outweighs the risks and burden of treatment.
            </p>
            <p>
              Some people will not be suitable candidates. Screening, informed consent and monitoring are required, and response cannot be predicted or guaranteed.
            </p>
          </div>
        </div>
        <div class="rounded-2xl overflow-hidden shadow-xl">
          <img
            src="/images/treatments/iv-patient-man.webp"
            alt="Patient receiving IV vitamin therapy in Halifax"
            class="w-full h-full object-cover"
            width="800"
            height="600"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <FAQSection items={[
          { question: "What happens at my first IV therapy visit?", answer: "<p>Your first visit includes a health review, discussion of your goals and a decision about whether IV therapy is appropriate. If treatment proceeds, we select nutrients for your needs and monitor you throughout the infusion. Many patients schedule a consultation before their first drip.</p>" },
          { question: "Is IV therapy covered by insurance?", answer: "<p>Coverage varies by insurer and plan. Ask your insurer whether naturopathic IV administration and treatment supplies are eligible under your specific policy before proceeding.</p>" },
          { question: "How often is IV therapy given?", answer: "<p>There is no standard schedule suitable for everyone. Whether treatment is offered at all, and whether it is repeated, depends on the indication, response, risks and available alternatives. This is decided through individual assessment rather than from website information.</p>" },
          { question: "What are the risks of IV therapy?", answer: "<p>Potential effects include discomfort, bruising or infection at the insertion site, light-headedness, changes in blood pressure, nausea, fluid or electrolyte problems and reactions to an ingredient. Additional risks and contraindications depend on the formulation and the person's health history. These are reviewed before consent.</p>" },
          { question: "What health problems can IV therapy help?", answer: "<p>Evidence differs substantially between formulations and health conditions. IV therapy is not presented as a treatment for a broad list of diagnoses. A consultation determines whether there is a specific, supportable indication or whether another form of care is more appropriate.</p>" },
        ]} />

  <ServiceArticles
    slugs={["post-viral-recovery-iv-therapy", "immune-support-natural-approaches", "magnesium-the-natural-muscle-relaxer"]}
    subtitle="Explore related topics on recovery, immunity and natural health."
  />

  <!-- Final CTA -->
  <section class="py-16 lg:py-24 bg-emerald-950">
    <div class="section-shell">
      <div class="text-center max-w-3xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-serif font-medium text-white mb-6">Considering IV Therapy?</h2>
        <p class="text-lg text-white/80 mb-8">
          Book a consultation to review whether IV therapy is appropriate for your circumstances, including potential benefits, limitations, alternatives and risks.
        </p>
        <CTAButton source="iv-therapy-cta" />
      </div>
    </div>
  </section>

  <!-- Service Schema Structured Data -->
  <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "IV Therapy",
      "serviceType": "Intravenous Nutrient Therapy",
      "description": "Individually assessed IV nutrient therapy with clinical screening, informed consent and monitoring in Bedford, Nova Scotia.",
      "provider": {
        "@type": "Person",
        "name": "Dr. Colin MacLeod",
        "jobTitle": "Naturopathic Doctor"
      },
      "areaServed": {
        "@type": "City",
        "name": "Halifax",
        "containedInPlace": {
          "@type": "State",
          "name": "Nova Scotia"
        }
      },
      "availableChannel": {
        "@type": "ServiceChannel",
        "serviceUrl": "https://drcolinmacleod.com/iv-therapy/",
        "serviceLocation": {
          "@type": "Place",
          "name": "Optimal Wellbeing Clinic",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "1378 Bedford Highway, Unit 1",
            "addressLocality": "Bedford",
            "addressRegion": "Nova Scotia",
            "postalCode": "B4A 1E2",
            "addressCountry": "CA"
          }
        }
      }
    }
  </script>
</BaseLayout>
