---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import ActionButton from '../components/ActionButton.astro';
const destinations = [
  { title: 'Services', href: '/services/', description: 'Explore consultations, testing and treatment options.' },
  { title: 'Your First Visit', href: '/new-patients/', description: 'Appointment preparation, fees and insurance information.' },
  { title: 'Contact', href: '/contact/', description: 'Get in touch or find directions to the clinic.' },
];
---
<BaseLayout title="Page Not Found" description="Find services, appointment information and contact details for Dr. Colin MacLeod, ND." noindex={true}>
  <HeroSection title="Page not found" centered compact>
    <p>The page may have moved, or the address may be incorrect. The links below can help you find your way.</p>
    <div slot="cta" class="flex flex-wrap justify-center gap-3">
      <ActionButton href="/" surface="light" variant="primary">Go Home</ActionButton>
      <ActionButton href="/articles/" surface="light" variant="secondary">Browse Articles</ActionButton>
    </div>
  </HeroSection>
  <section class="care-section">
    <div class="section-shell">
      <div class="mx-auto max-w-5xl">
        <h2 class="mb-8 text-3xl text-emerald-950">Find what you need</h2>
        <div class="grid gap-x-10 gap-y-2 sm:grid-cols-3">
          {destinations.map(item => (
            <a href={item.href} class="directory-link">
              <h3 class="mb-2 text-xl">{item.title}</h3>
              <p class="text-sm text-slate-600">{item.description}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
