---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import CTAButton from '../components/CTAButton.astro';
import { ChevronRight } from '@lucide/astro';

const conditionPages = [
  {
    title: 'Achilles Tendinitis',
    href: '/achilles-tendinitis/',
    description: 'Regenerative injection therapy to support tendon repair and address chronic heel and ankle pain.',
  },
  {
    title: 'Carpal Tunnel Syndrome',
    href: '/carpal-tunnel-syndrome/',
    description: 'Neural prolotherapy and injection therapies for nerve compression, pain and hand weakness.',
  },
  {
    title: 'Chronic Fatigue Syndrome',
    href: '/chronic-fatigue-syndrome/',
    description: 'Comprehensive assessment of fatigue patterns, recovery capacity, hormones, nutrients and immune function.',
  },
  {
    title: 'Fibromyalgia',
    href: '/fibromyalgia/',
    description: 'Multi-modal care for widespread pain, fatigue, sleep disruption and nervous system sensitivity.',
  },
  {
    title: 'Frozen Shoulder',
    href: '/frozen-shoulder/',
    description: 'Regenerative injection therapy to support range of motion and recovery from adhesive capsulitis.',
  },
  {
    title: "Golfer's Elbow",
    href: '/golfers-elbow/',
    description: 'Assessment and regenerative care for persistent medial elbow tendon pain.',
  },
  {
    title: 'Herniated Disc',
    href: '/herniated-disc/',
    description: 'Supportive care for disc-related pain, nerve irritation and recovery planning.',
  },
  {
    title: 'Low Back Pain',
    href: '/low-back-pain/',
    description: 'Regenerative injection therapies targeting disc, facet joint and ligament sources of back pain.',
  },
  {
    title: 'Migraine Headaches',
    href: '/migraine-headache/',
    description: 'Supportive care for migraine patterns, triggers, prevention and nervous system recovery.',
  },
  {
    title: 'Osteoarthritis',
    href: '/osteoarthritis/',
    description: 'Prolotherapy-based care for joint pain, stiffness and mobility limitations.',
  },
  {
    title: 'Plantar Fasciitis',
    href: '/plantar-fasciitis/',
    description: 'Regenerative injections to support plantar fascia healing and address persistent heel pain.',
  },
  {
    title: 'Rotator Cuff & Shoulder Impingement',
    href: '/rotator-cuff-shoulder-impingement/',
    description: 'Regenerative and supportive care for shoulder pain, tendon irritation and restricted motion.',
  },
  {
    title: "Runner's Knee",
    href: '/runners-knee/',
    description: 'Assessment and care options for patellofemoral pain, tracking issues and chronic knee irritation.',
  },
  {
    title: 'SI Joint Dysfunction',
    href: '/si-joint-dysfunction/',
    description: 'Evaluation and regenerative treatment for one-sided low back, buttock and pelvic pain.',
  },
  {
    title: 'Tennis Elbow',
    href: '/tennis-elbow/',
    description: 'Prolotherapy to support tendon repair and address chronic lateral elbow pain.',
  },
  {
    title: 'TMJ Dysfunction',
    href: '/tmj-dysfunction/',
    description: 'Neural prolotherapy and injection therapy for jaw pain, clicking, locking and restricted movement.',
  },
  {
    title: 'Whiplash & Neck Pain',
    href: '/whiplash-neck-pain/',
    description: 'Supportive care for neck pain, soft tissue injury and post-whiplash recovery.',
  },
];

const conditionGroups = [
  {
    title: 'Joints, Tendons & Mobility',
    description: 'Care information for common joint, tendon and activity-related concerns.',
    paths: [
      '/achilles-tendinitis/',
      '/frozen-shoulder/',
      '/golfers-elbow/',
      '/osteoarthritis/',
      '/plantar-fasciitis/',
      '/rotator-cuff-shoulder-impingement/',
      '/runners-knee/',
      '/tennis-elbow/',
    ],
  },
  {
    title: 'Spine, Nerve & Jaw',
    description: 'Pages addressing back, neck, nerve and jaw-related pain patterns.',
    paths: [
      '/carpal-tunnel-syndrome/',
      '/herniated-disc/',
      '/low-back-pain/',
      '/si-joint-dysfunction/',
      '/tmj-dysfunction/',
      '/whiplash-neck-pain/',
    ],
  },
  {
    title: 'Persistent & Whole-Body Concerns',
    description: 'Information for concerns that can affect energy, sleep, pain sensitivity and daily function.',
    paths: [
      '/chronic-fatigue-syndrome/',
      '/fibromyalgia/',
      '/migraine-headache/',
    ],
  },
].map((group) => ({
  ...group,
  conditions: group.paths
    .map((path) => conditionPages.find((condition) => condition.href === path))
    .filter((condition): condition is (typeof conditionPages)[number] => Boolean(condition)),
}));

---

<BaseLayout
  title="Conditions We Treat"
  description="Naturopathic support for musculoskeletal pain, chronic fatigue, digestive health, hormones, mood, respiratory health and other concerns in Bedford and Halifax, Nova Scotia."
  focusKeyword="conditions treated Halifax naturopathic"
>
  <HeroSection title="Conditions" centered compact>
    Support for acute and chronic health concerns using naturopathic assessment, lifestyle therapy, nutrition, IV therapy and regenerative injection approaches where appropriate.
  </HeroSection>

  <section class="py-16 lg:py-24 bg-white">
    <div class="section-shell">
      <div class="max-w-3xl mb-12 reveal">
        <p class="pill mb-4">Condition Pages</p>
        <h2 class="text-3xl sm:text-4xl font-serif font-medium text-emerald-950 mb-4">Care Information by Condition</h2>
        <p class="text-lg text-slate-600">
          Start with the area that best matches your concern. Each page describes the condition and the types of assessment or care that may be considered.
        </p>
      </div>

      <div class="space-y-14 reveal reveal-delay-100">
        {conditionGroups.map((group, groupIndex) => (
          <section
            aria-labelledby={`condition-group-${groupIndex}`}
            class:list={[
              groupIndex > 0 && 'border-t border-emerald-100 pt-12',
            ]}
          >
            <div class="mb-6 grid gap-2 md:grid-cols-[minmax(0,1fr)_minmax(18rem,0.8fr)] md:items-end md:gap-10">
              <h3 id={`condition-group-${groupIndex}`} class="text-2xl font-serif font-medium text-emerald-950 sm:text-3xl">
                {group.title}
              </h3>
              <p class="text-sm leading-relaxed text-slate-600 md:text-right">{group.description}</p>
            </div>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {group.conditions.map((condition) => (
                <a href={condition.href} class="site-card-interactive group flex h-full flex-col gap-3 p-5 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2">
                  <span class="flex items-start gap-2 text-lg font-semibold text-emerald-950 group-hover:text-emerald-700 transition-colors">
                    <ChevronRight class="mt-1 w-4 h-4 text-emerald-500 flex-shrink-0 group-hover:translate-x-0.5 transition-transform duration-200" aria-hidden="true" />
                    {condition.title}
                  </span>
                  <span class="text-sm text-slate-600 leading-relaxed">{condition.description}</span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-emerald-950 py-16 lg:py-24">
    <div class="section-shell text-center">
      <h2 class="text-3xl sm:text-4xl font-serif font-medium text-white mb-6">Don't See Your Condition Listed?</h2>
      <p class="text-lg sm:text-xl text-white/90 mb-8 max-w-3xl mx-auto leading-relaxed">
        Dr. MacLeod works with a wide range of health concerns. Contact us to discuss whether naturopathic care is a fit for your specific situation.
      </p>
      <div class="flex justify-center">
        <CTAButton source="conditions-cta" />
      </div>
    </div>
  </section>
</BaseLayout>
