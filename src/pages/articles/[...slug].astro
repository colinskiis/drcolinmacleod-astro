---
import PublicImage from '../../components/PublicImage.astro';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import { faqPageSchema } from '../../lib/faqSchema';
import RelatedArticles from '../../components/RelatedArticles.astro';
import OnThisPage from '../../components/OnThisPage.astro';
import { readingTime } from '../../lib/readingTime';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => data.draft !== true);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: article,
  }));
}

type Props = CollectionEntry<'articles'>;

const article = Astro.props;
const { Content, headings } = await render(article);
const minutes = readingTime(article.body ?? "");

const heroImage = article.data.heroImage;
const heroWebp =
  heroImage?.replace(/\.(png|jpe?g)$/i, '.webp') ?? null;
const heroUsesWebp = heroImage?.endsWith('.webp') ?? false;
// Use rendered headings so the navigation exactly matches Astro's anchor IDs.
const tocItems = headings
  .filter(({ depth, text }) => depth === 2 && text.toLowerCase() !== 'references')
  .map(({ text, slug }) => ({ title: text, id: slug }));
const showToc = tocItems.length >= 4;

// SEO preparation
const seoTitle = article.data.seo?.title || article.data.title;
const seoDescription = article.data.seo?.description || article.data.description;
const focusKeyword = article.data.seo?.focusKeyword || '';

// Format dates
const publishedDate = new Date(article.data.publishDate).toLocaleDateString('en-US', {
  timeZone: 'UTC',
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const modifiedDate = article.data.modifiedDate
  ? new Date(article.data.modifiedDate).toLocaleDateString('en-US', {
      timeZone: 'UTC',
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    })
  : null;

// BreadcrumbList schema for AI discoverability
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://drcolinmacleod.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Articles",
      "item": "https://drcolinmacleod.com/articles/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": article.data.title,
      "item": `https://drcolinmacleod.com/articles/${article.id}/`
    }
  ]
};

---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  focusKeyword={focusKeyword}
  image={heroImage}
  articleData={{
    publishDate: article.data.publishDate.toISOString(),
    modifiedDate: article.data.modifiedDate?.toISOString(),
    author: article.data.author,
    tags: article.data.tags,
  }}
>
  <!-- Reading Progress Bar -->
  <div id="reading-progress" class="fixed top-0 left-0 h-[3px] bg-emerald-500 z-50 transition-[width] duration-75 ease-out" style="width: 0%"></div>

  <!-- Article Header -->
  <article class="article-page py-8 sm:py-12 lg:py-16 bg-white">
    <div class="section-shell">
      <div class="article-shell mx-auto">

        <!-- Breadcrumbs -->
        <nav aria-label="Breadcrumb" class="flex items-center space-x-2 text-sm mb-7">
          <a href="/" class="-mx-1 inline-flex min-h-6 items-center rounded px-1 font-medium text-emerald-800 transition-colors hover:text-emerald-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500">Home</a>
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
          <a href="/articles/" class="-mx-1 inline-flex min-h-6 items-center rounded px-1 font-medium text-emerald-800 transition-colors hover:text-emerald-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500">Articles</a>
          <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
          <span class="text-slate-500 truncate min-w-0">{article.data.title}</span>
        </nav>

        <!-- Article Header -->
        <header class="article-header mb-8">
          <p class="mb-4 text-xs font-semibold uppercase tracking-[0.16em] text-emerald-800">Health journal</p>
          <h1 class="text-[2.125rem] sm:text-5xl font-serif font-medium text-emerald-950 mb-5 leading-[1.15] tracking-tight">
            {article.data.title}
          </h1>

          <p class="text-lg sm:text-xl text-slate-600 mb-6 leading-relaxed">
            {article.data.description}
          </p>

          <!-- Author Byline -->
          <div class="flex items-center gap-3 pt-6 border-t border-slate-200">
            <PublicImage
              src="/images/general/colin-hero.webp"
              alt="Dr. Colin MacLeod, ND"
              class="w-10 h-10 rounded-full object-cover object-top flex-shrink-0"
              loading="lazy"
              decoding="async"
            />
            <div>
              <span class="text-sm font-semibold text-slate-900">{article.data.author}</span>
              <div class="flex flex-wrap items-center gap-x-3 text-xs text-slate-500 mt-0.5">
                <time datetime={article.data.publishDate.toISOString()}>Published {publishedDate}</time>
                {modifiedDate && <time datetime={article.data.modifiedDate?.toISOString()}>Edited {modifiedDate}</time>}
                <span>{minutes} min read</span>
              </div>
            </div>
          </div>
        </header>

        <!-- Hero Image -->
        {heroImage && (
          <div class="article-cover mb-8 aspect-[12/5] overflow-hidden rounded-lg">
            <picture>
              {heroWebp && !heroUsesWebp && (
                <source srcset={heroWebp} type="image/webp" />
              )}
              <PublicImage
                src={heroImage}
                alt=""
                class="w-full h-full object-cover"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </picture>
          </div>
        )}

        {showToc && <OnThisPage items={tocItems} display="mobile" breakpoint="xl" label="Article sections" />}

        <!-- Article Content -->
        <div class="article-reading-layout">
          <div id="article-body" class="prose article-prose">
            <Content />
          </div>

          {showToc && <OnThisPage items={tocItems} display="desktop" breakpoint="xl" label="Article sections" />}
        </div>

        {article.data.faq && article.data.faq.length > 0 && (
          <section class="article-supplement mt-10 border-t border-slate-200 pt-8" aria-labelledby="article-faq-heading">
            <h2 id="article-faq-heading" class="text-2xl font-serif font-medium text-emerald-950 mb-5">Questions and answers</h2>
            <FAQAccordion items={article.data.faq} />
          </section>
          <script is:inline type="application/ld+json" set:html={JSON.stringify(faqPageSchema(article.data.faq))} />
        )}

        <!-- Article Footer -->
        <footer class="article-supplement mt-10 pt-8 border-t border-slate-200">
          <div class="flex items-start gap-4 mb-10">
            <PublicImage
              src="/images/general/colin-hero.webp"
              alt=""
              class="w-12 h-12 rounded-full object-cover object-top flex-shrink-0"
              loading="lazy"
              decoding="async"
            />
            <div class="min-w-0">
              <h2 class="text-lg font-serif font-medium text-emerald-950 mb-2">About the author</h2>
              <p class="text-sm leading-relaxed text-slate-600 mb-2">
                Dr. Colin MacLeod, ND is a licensed naturopathic doctor in Halifax, Nova Scotia.
                His interests include blood test interpretation, pain care, IV therapy and exercise.
              </p>
              <a href="/about/" class="inline-flex min-h-11 items-center text-sm font-medium text-emerald-800 underline underline-offset-4">Meet Dr. MacLeod</a>
            </div>
          </div>

          {article.data.relatedLinks && article.data.relatedLinks.length > 0 && (
            <nav aria-label="Further resources" class="mb-8">
              <h2 class="text-xl font-serif font-medium text-emerald-950 mb-3">Further resources</h2>
              <ul class="flex flex-wrap gap-x-6 gap-y-1">
                {article.data.relatedLinks.map(({ title, href }) => (
                  <li><a href={href} class="inline-flex min-h-11 items-center text-sm text-emerald-800 underline underline-offset-4">{title}</a></li>
                ))}
              </ul>
            </nav>
          )}

          <RelatedArticles
            currentSlug={article.id}
            currentTags={article.data.tags || []}
            currentCategories={article.data.categories}
            excludePaths={article.data.relatedLinks?.map(({ href }) => href)}
            limit={3}
          />

          <!-- Back link -->
          <a
            href="/articles/"
            class="mt-8 inline-flex min-h-11 items-center text-emerald-800 hover:text-emerald-900 font-medium"
          >
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            Back to All Articles
          </a>
        </footer>
      </div>
    </div>
  </article>

  <!-- Reading progress script -->
  <script>
    let progressListener: ((e: Event) => void) | null = null;

    function initReadingProgress() {
      // Remove previous scroll listener if navigating between articles
      if (progressListener) {
        window.removeEventListener('scroll', progressListener);
        window.removeEventListener('resize', progressListener);
        progressListener = null;
      }

      const bar = document.getElementById('reading-progress');
      const article = document.getElementById('article-body');
      if (!bar || !article) return;
      const progressBar = bar;
      const articleEl = article;

      function updateProgress() {
        const articleTop = articleEl.getBoundingClientRect().top + window.scrollY;
        const articleHeight = articleEl.offsetHeight;
        const scrolled = window.scrollY - articleTop;
        const available = articleHeight - window.innerHeight;
        const progress = available > 0 ? Math.min(Math.max(scrolled / available, 0), 1) : (scrolled >= 0 ? 1 : 0);
        progressBar.style.width = (progress * 100) + '%';
      }

      progressListener = updateProgress;
      window.addEventListener('scroll', updateProgress, { passive: true });
      window.addEventListener('resize', updateProgress);
      updateProgress();
    }

    document.addEventListener('astro:page-load', initReadingProgress);
  </script>

  <!-- BreadcrumbList Schema for AI discoverability -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

</BaseLayout>
