---
import FeaturedServices from '../components/FeaturedServices.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import PageJumpLinks from '../components/PageJumpLinks.astro';
import FirstVisitGuidance from '../components/FirstVisitGuidance.astro';
import BookingButton from '../components/BookingButton.astro';
import { ChevronRight } from '@lucide/astro';

const serviceGroups = [
  {
    title: 'Natural Healthcare',
    items: [
      { label: 'Lab Testing', href: '/lab-testing/' },
      { label: 'Clinical Nutrition', href: '/clinical-nutrition/' },
      { label: 'Herbal Therapy', href: '/herbal-therapy/' },
      { label: 'Acupuncture', href: '/acupuncture/' },
      { label: 'Sports Performance & Injury', href: '/sports-performance-injury/' },
    ],
  },
  {
    title: 'IV Therapy',
    items: [
      { label: 'Myers Cocktail', href: '/myers-cocktail-intravenous-nutrients/' },
      { label: 'NAD+ Therapy', href: '/nad-therapy/' },
      { label: 'Chelation Therapy', href: '/chelation-therapy/' },
      { label: 'IV Vitamin C', href: '/iv-vitamin-c/' },
      { label: 'Glutathione', href: '/glutathione/' },
    ],
  },
  {
    title: 'Pain & Injection',
    items: [
      { label: 'Prolotherapy', href: '/prolotherapy/' },
      { label: 'Neural Prolotherapy', href: '/neural-prolotherapy-pain/' },
      { label: 'Microcurrent Therapy', href: '/microcurrent-therapy/' },
    ],
  },
];

const pricingGroups = [
  {
    title: 'Consultations',
    rows: [
      ['Initial Visit (60 minutes)', '$200'],
      ['Follow-up Visit', '$100'],
    ],
  },
  {
    title: 'Treatments',
    rows: [
      ['IV Therapy', '$130'],
      ['Injection Treatments', '$110'],
      ['Acupuncture', '$75'],
      ['Vitamin B12 Injection', '$35'],
    ],
  },
  {
    title: 'Specialized IV Treatments',
    rows: [
      ['NAD+ IV Therapy', '$190'],
      ['Myers Cocktail', '$130'],
      ['Chelation Therapy', '$130'],
    ],
  },
];
---

<BaseLayout
  title="Services"
  description="Complete naturopathic healthcare services including IV therapy, prolotherapy, acupuncture, clinical nutrition and specialized treatments for chronic conditions in Halifax, Nova Scotia."
  focusKeyword="naturopathic services Halifax"
>
  <HeroSection title="Naturopathic Services" centered compact>
    Private testing, clinical consultations and in-office treatments selected according to your health history, priorities and goals.
  </HeroSection>

  <PageJumpLinks items={[
    { id: 'starting-point', title: 'Where to start' },
    { id: 'all-services', title: 'All services' },
    { id: 'pricing', title: 'Service pricing' },
  ]} />

  <!-- Featured Service Areas -->
  <section id="starting-point" class="care-section scroll-mt-32">
    <div class="section-shell">
      <div class="mb-8 max-w-3xl ">
        <h2 class="text-3xl sm:text-4xl font-serif font-medium text-emerald-950 mb-4">Find the right starting point</h2>
        <p class="text-lg text-slate-600">
          Laboratory testing is the most common reason patients contact the practice. All new patients complete a one-hour initial consultation first. IV therapy and prolotherapy may then be scheduled separately if appropriate.
        </p>
      </div>

      <div class="">
        <FeaturedServices />
      </div>
    </div>
  </section>

  <!-- Service Directory -->
  <section id="all-services" class="care-section scroll-mt-32">
    <div class="section-shell">
      <div class="mb-8 text-left ">
        <h2 class="text-2xl sm:text-3xl font-serif font-medium text-emerald-950 mb-2">All Services</h2>
        <p class="text-slate-600">Browse our complete list of treatments and services</p>
      </div>

      <div class="overflow-hidden rounded-2xl border border-emerald-100 bg-white shadow-sm ">
        <div class="grid divide-y divide-emerald-100 md:grid-cols-3 md:divide-x md:divide-y-0">
          {serviceGroups.map((group) => (
            <div class="p-6">
              <h3 class="mb-4 text-base font-serif font-medium text-emerald-950">{group.title}</h3>
              <ul class="space-y-1">
                {group.items.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="group flex items-center justify-between rounded-lg px-2 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-emerald-50 hover:text-emerald-800 focus:outline-none focus:ring-2 focus:ring-emerald-500"
                    >
                      <span>{item.label}</span>
                      <ChevronRight class="h-4 w-4 text-emerald-700 transition-transform group-hover:translate-x-0.5 group-hover:text-emerald-600" aria-hidden="true" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Section -->
  <section id="pricing" class="care-section scroll-mt-32">
    <div class="section-shell">
      <div class="text-left mb-10 ">
        <h2 class="text-3xl sm:text-4xl font-serif font-medium text-emerald-950 mb-4">Service Pricing</h2>
        <p class="text-lg text-slate-600 max-w-3xl mx-auto">
          Coverage and direct billing depend on your individual insurance plan. Please confirm your eligibility and limits.
        </p>
      </div>

      <p class="mx-auto mb-6 max-w-3xl text-center leading-relaxed text-slate-600">All new patients begin with a 60-minute initial consultation ($200). IV therapy and injection treatments, including prolotherapy, are scheduled separately after this visit if appropriate. Treatment prices below are separate from the consultation fee. Private laboratory fees are confirmed before testing proceeds.</p>

      <div class="mx-auto max-w-4xl overflow-hidden rounded-2xl border border-emerald-100 bg-white shadow-sm ">
        {pricingGroups.map((group, groupIndex) => (
          <div class:list={[
            'grid md:grid-cols-[220px_1fr]',
            groupIndex !== pricingGroups.length - 1 && 'border-b border-emerald-100',
          ]}>
            <div class="bg-emerald-50/70 px-5 py-4 md:px-6">
              <h3 class="font-serif font-medium text-emerald-950">{group.title}</h3>
            </div>
            <ul class="divide-y divide-slate-100">
              {group.rows.map(([label, price]) => (
                <li class="flex items-center justify-between gap-6 px-5 py-4 md:px-6">
                  <span class="text-slate-700">{label}</span>
                  <span class="font-semibold text-emerald-950">{price}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="care-closing">
    <div class="section-shell">
      <div class="text-center max-w-3xl mx-auto ">
        <h2 class="text-3xl sm:text-4xl font-serif font-medium text-white mb-6">Not Sure Where to Start?</h2>
        <FirstVisitGuidance />
        <BookingButton destination="initial" source="services-cta" placement="closing" />
      </div>
    </div>
  </section>
</BaseLayout>
