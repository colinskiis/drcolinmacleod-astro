---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import CTAButton from '../components/CTAButton.astro';
import ArticleSearch from '../components/ArticleSearch.astro';
import { getCollection } from 'astro:content';
import { articleTopicFilters, articleTopics, getArticleTopics } from '../lib/articleTopics';
import { toArticleSearchIndex } from '../lib/articleSearchIndex';
import { readingTime } from '../lib/readingTime';

const topicLabel = (article: (typeof allArticles)[number]) => {
  const id = getArticleTopics(article)[0];
  return articleTopics.find((t) => t.id === id)?.label;
};

const allArticles = await getCollection('articles', ({ data }) => {
  return data.draft !== true;
});
const sortedArticles = allArticles.sort((a, b) =>
  new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

const featuredArticles = sortedArticles.slice(0, 3);
// The browse list keeps every article so search can always reach them, but the
// three already shown as featured cards start hidden — otherwise the same three
// appear twice within one screen. "Show all" and any search reveal them.
const browseArticles = sortedArticles;
const initiallyVisibleArticles = 12;
const isDefaultHidden = (index: number) =>
  index < featuredArticles.length ||
  index >= featuredArticles.length + initiallyVisibleArticles;
const defaultVisibleCount = browseArticles.filter((_, index) => !isDefaultHidden(index)).length;
const articleSearchIndex = toArticleSearchIndex(browseArticles);

const topicCounts = articleTopicFilters.reduce((counts, topic) => {
  counts[topic.id] = topic.id === 'all'
    ? sortedArticles.length
    : sortedArticles.filter((article) => getArticleTopics(article).includes(topic.id)).length;
  return counts;
}, {} as Record<string, number>);

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Health Articles & Resources",
  "description": "Evidence-based articles on natural health, nutrition, herbal therapy and naturopathic treatments by Dr. Colin MacLeod, ND in Halifax, Nova Scotia.",
  "url": "https://drcolinmacleod.com/articles/",
  "hasPart": articleTopics.map((topic) => ({
    "@type": "CollectionPage",
    "name": topic.title,
    "url": `https://drcolinmacleod.com/articles/${topic.id}/`
  }))
};
---

<BaseLayout
  title="Health Articles & Resources"
  description="Evidence-based articles on natural health, nutrition, herbal therapy and naturopathic treatments by Dr. Colin MacLeod, ND in Halifax, Nova Scotia."
  focusKeyword="naturopathic health articles Halifax"
  customSchemas={[collectionSchema]}
>
  <HeroSection title="Articles" centered compact>
    <p>Evidence-based articles on natural health, nutrition and treatment approaches</p>
  </HeroSection>

  <section class="py-16 lg:py-24 bg-white">
    <div class="section-shell">
      <div class="max-w-4xl mx-auto reveal">
        <section aria-labelledby="featured-articles-heading" class="mb-14">
          <div class="mb-6 flex items-end justify-between gap-6">
            <div>
              <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-emerald-700">New and noteworthy</p>
              <h2 id="featured-articles-heading" class="text-3xl font-serif font-medium text-emerald-950 sm:text-4xl">Featured &amp; Recent</h2>
            </div>
          </div>
          <div class="grid gap-5 md:grid-cols-3">
            {featuredArticles.map((article, index) => (
              <a
                href={`/articles/${article.slug}/`}
                class:list={[
                  'group overflow-hidden rounded-2xl border border-emerald-100 bg-white shadow-sm shadow-emerald-950/5 transition-all duration-200 hover:-translate-y-0.5 hover:border-emerald-200 hover:shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2',
                  index > 0 && 'hidden md:block',
                ]}
              >
                {article.data.heroImage && (
                  <div class="aspect-[16/10] overflow-hidden bg-emerald-50">
                    <img
                      src={article.data.heroImage}
                      alt=""
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}
                <div class="p-5">
                  <div class="mb-2 flex flex-wrap items-center gap-x-2 text-xs text-slate-600">
                    <time>
                      {new Date(article.data.publishDate).toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                      })}
                    </time>
                    <span aria-hidden="true">&middot;</span>
                    <span>{readingTime(article.body)} min read</span>
                  </div>
                  <h3 class="text-xl font-serif font-medium leading-snug text-emerald-950 transition-colors group-hover:text-emerald-700">
                    {article.data.title}
                  </h3>
                  <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-slate-600">{article.data.description}</p>
                </div>
              </a>
            ))}
          </div>
        </section>

        <section aria-labelledby="browse-articles-heading" class="border-t border-emerald-100 pt-12">
          <div class="mb-7">
            <h2 id="browse-articles-heading" class="text-3xl font-serif font-medium text-emerald-950">Browse All Articles</h2>
            <p class="mt-2 text-slate-600">Filter by topic or search for a specific concern.</p>
          </div>

        <div class="mb-8 sm:mb-10">
          <nav class="grid grid-cols-2 gap-2 sm:flex sm:flex-wrap sm:gap-3" aria-label="Browse articles by topic">
            {articleTopicFilters.map((topic) => (
              <a
                href={topic.id === 'all' ? '/articles/' : `/articles/${topic.id}/`}
                aria-current={topic.id === 'all' ? 'page' : undefined}
                class:list={[
                  'rounded-full border px-3 py-2 text-sm font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 sm:px-4',
                  topic.id === 'all'
                    ? 'border-emerald-900 bg-emerald-900 text-white'
                    : 'border-emerald-100 bg-white text-emerald-900 hover:border-emerald-300 hover:bg-emerald-50'
                ]}
              >
                <span>{topic.label}</span>
                <span class:list={[
                  'ml-1 text-xs',
                  topic.id === 'all' ? 'text-white/80' : 'text-slate-600'
                ]} aria-hidden="true">{topicCounts[topic.id]}</span>
              </a>
            ))}
          </nav>
        </div>

        <ArticleSearch articles={articleSearchIndex} initialVisibleCount={defaultVisibleCount} />

        <div id="article-list">
        {browseArticles.map((article, index) => (
          <a
            href={`/articles/${article.slug}/`}
            data-article-search-item
            data-article-slug={article.slug}
            data-default-hidden={isDefaultHidden(index) ? 'true' : undefined}
            class:list={[
              'group flex items-center gap-4 py-5 border-b border-slate-100 last:border-0 -mx-4 px-4 rounded-lg hover:bg-emerald-50/50 transition-colors focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-inset',
              isDefaultHidden(index) && 'article-overflow',
            ]}
          >
            {article.data.heroImage && (
              <div class="hidden sm:block w-24 h-16 rounded-lg overflow-hidden flex-shrink-0 bg-emerald-50">
                <img
                  src={article.data.heroImage}
                  alt=""
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
            <div class="flex-1 min-w-0">
              <div class="flex flex-wrap items-center gap-x-2 text-xs text-slate-500 mb-1">
                <time>
                  {new Date(article.data.publishDate).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric'
                  })}
                </time>
                <span aria-hidden="true">&middot;</span>
                <span>{readingTime(article.body)} min read</span>
                {topicLabel(article) && (
                  <>
                    <span aria-hidden="true">&middot;</span>
                    <span class="text-emerald-700 font-medium">{topicLabel(article)}</span>
                  </>
                )}
              </div>
              <h2 class="article-search-title text-lg sm:text-xl font-serif font-medium text-slate-900 group-hover:text-emerald-700 transition-colors leading-snug">
                {article.data.title}
              </h2>
              <p class="article-search-description text-sm text-slate-500 mt-1 line-clamp-2">{article.data.description}</p>
            </div>
            <svg class="w-5 h-5 text-slate-300 group-hover:text-emerald-600 transition-colors flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ))}
        </div>

        {browseArticles.length > defaultVisibleCount && (
          <div class="mt-8 text-center">
            <button
              type="button"
              data-article-show-more
              class="article-show-more min-h-12 items-center justify-center rounded-full border border-emerald-900 bg-white px-7 py-3 font-semibold text-emerald-900 transition-colors hover:bg-emerald-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2"
            >
              Show all {browseArticles.length} articles
            </button>
          </div>
        )}

        <script>
          import '../scripts/articleListSearch.ts';
        </script>
        </section>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-emerald-950 py-16 lg:py-24">
    <div class="section-shell text-center">
      <h2 class="text-3xl sm:text-4xl font-serif font-medium text-white mb-6">Take Control of Your Health</h2>
      <p class="text-lg sm:text-xl text-white/90 mb-8 max-w-3xl mx-auto leading-relaxed">
        Questions about natural health approaches? Book your appointment to discuss how naturopathic care can support your health goals.
      </p>
      <div class="flex justify-center">
        <CTAButton source="articles-cta" placement="closing" />
      </div>
    </div>
  </section>

</BaseLayout>
