---
import BookingButton from './BookingButton.astro';

export interface Props {
  title: string;
  description: string;
  source: string;
}

const { title, description, source } = Astro.props;
---

<section class="care-closing">
  <div class="section-shell text-center">
    <div class="mx-auto max-w-3xl">
      <h2 class="h-section mb-5 font-serif font-medium text-white">{title}</h2>
      <p class="mb-8 text-lg leading-relaxed text-white/85">{description}</p>
      <BookingButton text="Book Online" variant="primary" surface="dark" size="lg" source={source} placement="closing" />
    </div>
  </div>
</section>
