---
export interface Props {
  title: string;
  /** Heading level for the card title. Use 2 where the card group is the first
      section under the page h1, so the outline doesn't skip from h1 to h3. */
  level?: 2 | 3;
}

const { title, level = 3 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
---

<div class="care-item">
  <Heading class="mb-3 text-xl font-serif font-medium text-emerald-950">{title}</Heading>
  <div class="text-slate-600">
    <slot />
  </div>
</div>
