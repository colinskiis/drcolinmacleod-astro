---
import { ChevronDown } from '@lucide/astro';

export interface FAQItem {
  question: string;
  answer: string;
}

export interface Props {
  items: FAQItem[];
}

const { items } = Astro.props;
---

<div class="max-w-3xl mx-auto border-t border-emerald-900/20">
  {items.map((item) => (
    <details class="group border-b border-emerald-900/20">
      <summary class="flex items-center justify-between py-5 gap-4 cursor-pointer list-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500">
        <span class="text-base sm:text-lg font-medium text-emerald-950">{item.question}</span>
        <ChevronDown class="w-5 h-5 text-emerald-700 flex-shrink-0 transition-transform duration-300 group-open:rotate-180" aria-hidden="true" />
      </summary>
      <div class="pb-6 pr-6 text-slate-600 leading-relaxed" set:html={item.answer} />
    </details>
  ))}
</div>
