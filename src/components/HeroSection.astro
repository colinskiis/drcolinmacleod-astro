---
import PublicImage from './PublicImage.astro';
import VideoPreview from './VideoPreview.astro';
import { isConditionPath, isLabTestingPath, isServicePath } from '../config/routes';

export interface Props {
  title: string;
  centered?: boolean;
  compact?: boolean;
  textOnly?: boolean;
  image?: { src: string; alt: string; aspect?: 'video' | 'square'; hideOnMobile?: boolean };
  video?: { src: string; title: string; poster?: string };
}
const { title, centered = false, compact = false, textOnly = false, image, video } = Astro.props;
const path = Astro.url.pathname;
const condition = isConditionPath(path);
const service = isServicePath(path);
const care = condition || service;
const breadcrumb = isLabTestingPath(path) && path !== '/lab-testing/'
  ? { href: '/lab-testing/', label: 'Lab Testing' }
  : service ? { href: '/services/', label: 'Services' }
  : condition ? { href: '/conditions/', label: 'Conditions' } : null;
// Conditions lead with information. Their supporting imagery belongs beside the
// relevant explanation, rather than delaying it in a large introductory banner.
const showMedia = !condition && !textOnly && !centered && (image || video || Astro.slots.has('media'));
---

<section class:list={['page-hero', care ? 'page-hero--care' : 'page-hero--general', compact && 'page-hero--compact']}>
  <div class="section-shell">
    <div class:list={['page-hero__layout', showMedia && 'page-hero__layout--media', centered && !care && 'page-hero__layout--centered']}>
      <div class="min-w-0">
        {Astro.slots.has('breadcrumb') ? <slot name="breadcrumb" /> : breadcrumb && (
          <nav class="page-hero__breadcrumb" aria-label="Breadcrumb">
            <a href={breadcrumb.href}>{breadcrumb.label}</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{title}</span>
          </nav>
        )}
        <h1>{title}</h1>
        <div class="page-hero__intro"><slot /></div>
        {Astro.slots.has('cta') && <div class="mt-7"><slot name="cta" /></div>}
      </div>
      {showMedia && (
        <div class:list={['page-hero__media', image?.hideOnMobile && 'hidden lg:block']}>
          {image ? (
            <PublicImage src={image.src} alt={image.alt}
              loading="eager" fetchpriority="high" decoding="async" />
          ) : video?.poster ? <VideoPreview src={video.src} title={video.title} poster={video.poster} />
          : video ? (
            <iframe src={video.src} title={video.title} class="aspect-video w-full" style="border:0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen />
          ) : <slot name="media" />}
        </div>
      )}
    </div>
  </div>
</section>
