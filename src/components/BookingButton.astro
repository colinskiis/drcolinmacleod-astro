---
import { Calendar } from '@lucide/astro';
import { buttonClasses } from '../lib/buttonStyles';

/**
 * The single booking call-to-action for the whole site.
 *
 * Two independent axes:
 *
 *   variant — semantic emphasis. `primary` is "book an appointment" and looks
 *     the same everywhere, because that repetition is what teaches people to
 *     recognise it. `secondary` is any lesser action.
 *
 *   surface — physical. A solid button cannot use one fill on both dark and
 *     light sections, so the palette inverts. The visual weight does not.
 *
 * Do not add variants that vary *emphasis* by section type. That is
 * inconsistency wearing a rationale, and it spends the recognition that makes a
 * booking button work.
 *
 * Visual styles live in `src/lib/buttonStyles.ts`, shared with ActionButton so
 * booking and non-booking controls stay in step. Contrast figures are
 * documented there.
 *
 * TRACKING — read before restyling:
 *   `data-booking-source` on the root <a> is what fires the GA4 `booking_click`
 *   event, through one delegated listener in BaseLayout.astro. That attribute is
 *   the entire contract. The `booking-btn` class is NOT a tracking hook and has
 *   no CSS rule behind it anywhere in this project. Removing or renaming
 *   `data-booking-source` stops conversion tracking silently, with no visible
 *   symptom on the page.
 */

/** Superseded names, still accepted so call sites can migrate gradually. */
type LegacyVariant = 'hero' | 'outline';

export interface Props {
  text?: string;
  /** Semantic emphasis. Booking is `primary` almost everywhere. */
  variant?: 'primary' | 'secondary' | LegacyVariant;
  /** The background this sits on. Picks the palette, never the weight. */
  surface?: 'dark' | 'light';
  size?: 'sm' | 'md' | 'lg';
  /**
   * Which CTA this is, for analytics. Required: it used to default to
   * "unknown", and eleven CTAs reached production reporting exactly that.
   */
  source: string;
  /** Fixed vocabulary, so GA4 gets a dimension it can actually group by. */
  placement?: 'hero' | 'inline' | 'sidebar' | 'closing' | 'nav' | 'footer' | 'sticky';
  icon?: boolean;
  fullWidth?: boolean;
}

const {
  text = 'Book Online',
  variant = 'primary',
  surface = 'dark',
  size = 'md',
  source,
  placement,
  icon = true,
  fullWidth = false,
} = Astro.props;

// `hero` was only ever `primary` at a larger size. `outline` was `secondary` on
// a light surface.
const LEGACY: Record<LegacyVariant, { variant: 'primary' | 'secondary'; surface: 'dark' | 'light' }> = {
  hero: { variant: 'primary', surface: 'dark' },
  outline: { variant: 'secondary', surface: 'light' },
};
const resolved = (variant === 'hero' || variant === 'outline')
  ? LEGACY[variant]
  : { variant, surface };

const classes = `booking-btn ${buttonClasses({ variant: resolved.variant, surface: resolved.surface, size, fullWidth })}`;
---

<a
  href="https://macleodnaturopathic.janeapp.com/"
  target="_blank"
  rel="noopener noreferrer"
  class={classes}
  data-booking-source={source}
  data-booking-placement={placement}
>
  <span>{text}</span>
  {icon && <Calendar class="w-5 h-5 ml-2" aria-hidden="true" />}
  <span class="sr-only"> (opens in a new tab)</span>
</a>
