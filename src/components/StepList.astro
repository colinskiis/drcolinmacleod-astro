---
export interface StepItem {
  title: string;
  description: string;
}

export interface Props {
  steps: StepItem[];
  size?: 'sm' | 'md';
  variant?: 'dark' | 'light';
}

const { steps } = Astro.props;
---
<ol class="divide-y divide-emerald-100">
  {steps.map((step, index) => (
    <li class="flex gap-4 py-5 items-start">
      <span class="care-number pt-1" aria-hidden="true">0{index + 1}</span>
      <div>
        <h3 class="font-serif font-medium text-xl text-emerald-950 mb-2">{step.title}</h3>
        <p class="text-slate-600">{step.description}</p>
      </div>
    </li>
  ))}
</ol>
