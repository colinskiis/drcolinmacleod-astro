---
import PublicImage from './PublicImage.astro';
import { ChevronRight } from '@lucide/astro';

const services = [
  { title: 'Lab Testing', description: 'Private blood work, in-office collection and testing tailored to your concerns.', image: '/images/lab-testing/in-office-blood-draw.webp', alt: 'Dr. Colin MacLeod performing an in-office blood draw', position: 'object-[center_35%]', href: '/lab-testing/' },
  { title: 'IV Therapy', description: 'Individualized nutrient therapy with clinical screening and monitoring.', image: '/images/treatments/iv-patient-woman.webp', alt: 'Patient receiving IV nutrient therapy in the clinic', position: 'object-center', href: '/iv-therapy/' },
  { title: 'Prolotherapy', description: 'An injection-based option for selected joint, tendon and ligament concerns.', image: '/images/treatments/prolotherapy-knee-injection.webp', alt: 'Dr. Colin MacLeod performing a prolotherapy knee injection', position: 'object-[center_35%]', href: '/prolotherapy/' },
];
---
<div class="grid gap-4 md:grid-cols-3 md:gap-6" data-featured-services>
  {services.map(service => (
    <a href={service.href} class="group grid grid-cols-[5.5rem_minmax(0,1fr)] items-start gap-4 overflow-hidden rounded-2xl border border-emerald-100 bg-white p-4 transition-colors hover:border-emerald-400 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 focus-visible:ring-offset-2 md:flex md:flex-col md:gap-0 md:p-0">
      <div class="h-24 w-full overflow-hidden rounded-lg md:h-40 md:shrink-0 md:rounded-none">
        <PublicImage src={service.image} alt={service.alt} loading="lazy" class={`h-full w-full object-cover ${service.position}`} />
      </div>
      <div class="flex min-w-0 flex-col md:flex-1 md:p-5">
        <h3 class="mb-2 text-xl font-serif font-medium text-emerald-950 group-hover:text-emerald-700">{service.title}</h3>
        <p class="text-sm leading-relaxed text-slate-600">{service.description}</p>
        <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-emerald-800 md:mt-auto md:pt-4">Learn more <ChevronRight class="h-4 w-4" aria-hidden="true" /></span>
      </div>
    </a>
  ))}
</div>
