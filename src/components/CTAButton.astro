---
import BookingButton from './BookingButton.astro';

/**
 * @deprecated Use `BookingButton` directly.
 *
 * A forwarding wrapper, kept so the ~50 existing call sites can migrate a file
 * at a time rather than in one sweep. It renders exactly what `BookingButton`
 * renders.
 *
 * `size="lg"` is preserved deliberately: this component hard-coded
 * `px-10 py-4 text-lg` with no size prop, so every one of its call sites is a
 * large button. Dropping that would silently shrink fifty CTAs.
 *
 * Props dropped because nothing used them: `href` and `external` (no call site
 * overrode either — `BookingButton` owns the JaneApp URL), `variant="secondary"`
 * (zero usages), and the text slot (three usages, all passing the default
 * "Book Online", which CLAUDE.md mandates for every booking button anyway).
 *
 * Migration: `<CTAButton source="x" />` becomes
 * `<BookingButton source="x" size="lg" placement="..." />`.
 */

export interface Props {
  source: string;
  placement?: 'hero' | 'inline' | 'sidebar' | 'closing' | 'nav' | 'footer' | 'sticky';
}

const { source, placement } = Astro.props;
---

<BookingButton
  variant="primary"
  surface="dark"
  size="lg"
  source={source}
  placement={placement}
/>
