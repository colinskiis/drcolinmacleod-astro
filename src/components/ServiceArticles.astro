---
import { getCollection } from 'astro:content';

interface Props {
  slugs: string[];
  title?: string;
  subtitle?: string;
  bg?: 'white' | 'emerald';
}

const { slugs, title = "Learn More", subtitle, bg = 'white' } = Astro.props;

const allArticles = await getCollection('articles', ({ data }) => data.draft !== true);

const articles = slugs
  .map(slug => allArticles.find(a => a.id === slug))
  .filter(Boolean);

const sectionClass = bg === 'emerald' ? 'care-section care-section--tint' : 'care-section';
const cardClass = 'directory-link group';
---

{articles.length > 0 && (
  <section class={sectionClass}>
    <div class="section-shell">
      <div class="max-w-5xl mx-auto mb-8">
        <h2 class="text-3xl sm:text-4xl font-serif font-medium text-emerald-950 mb-4">{title}</h2>
        {subtitle && <p class="text-lg text-slate-600">{subtitle}</p>}
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 max-w-5xl mx-auto">
        {articles.map(article => (
          <a href={`/articles/${article!.id}/`} class={cardClass}>
            <h3 class="font-serif font-medium text-emerald-950 mb-2 group-hover:text-emerald-700 transition-colors">{article!.data.title}</h3>
            <p class="text-slate-600 text-sm">{article!.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
